#version 450

// Soft-particle motion update (GPU). Spawn remains CPU; trails sample after readback.
layout(local_size_x = 64) in;

struct GpuParticle {
    vec4 pos_age;       // xyz position, w age
    vec4 vel_life;      // xyz velocity, w lifetime
    vec4 size_params;   // x size0, y aspect, z stretch, w unused
    uvec4 meta;         // x flags, y emitter_node, z emit_index, w host_slot
    vec4 gravity;       // xyz gravity
    vec4 accel_drag;    // xyz accel, w drag
    vec4 kill_plane;    // x kill_y when flag set
};

layout(std430, binding = 0) buffer ParticleBuffer {
    GpuParticle particles[];
};

layout(push_constant) uniform Push {
    uint count;
    float dt;
    float sim_time;
    uint _pad;
} push;

const uint FLAG_ALIVE = 1u;
const uint FLAG_GRAVITY = 2u;
const uint FLAG_ACCEL = 4u;
const uint FLAG_DRAG = 8u;
const uint FLAG_KILL_PLANE = 16u;

void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= push.count) {
        return;
    }

    GpuParticle p = particles[i];
    uint flags = p.meta.x;
    if ((flags & FLAG_ALIVE) == 0u) {
        return;
    }

    float age = p.pos_age.w + push.dt;
    float lifetime = p.vel_life.w;
    if (age >= lifetime) {
        p.meta.x = flags & ~FLAG_ALIVE;
        p.pos_age.w = age;
        particles[i] = p;
        return;
    }

    vec3 pos = p.pos_age.xyz;
    vec3 vel = p.vel_life.xyz;

    if ((flags & FLAG_GRAVITY) != 0u) {
        vel += p.gravity.xyz * push.dt;
    }
    if ((flags & FLAG_ACCEL) != 0u) {
        vel += p.accel_drag.xyz * push.dt;
    }
    if ((flags & FLAG_DRAG) != 0u) {
        float drag = p.accel_drag.w;
        vel *= max(0.0, 1.0 - drag * push.dt);
    }

    pos += vel * push.dt;

    if ((flags & FLAG_KILL_PLANE) != 0u && pos.y < p.kill_plane.x) {
        flags &= ~FLAG_ALIVE;
    }

    p.pos_age = vec4(pos, age);
    p.vel_life = vec4(vel, lifetime);
    p.meta.x = flags;
    particles[i] = p;
}
