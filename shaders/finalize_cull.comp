#version 450

struct BatchCullHeader {
    uint instanceOffset;
    uint instanceCount;
    uint visibleOffset;
    uint visibleCount;
};

layout(set = 0, binding = 0) buffer BatchHeaders {
    BatchCullHeader batches[];
} uBatches;

layout(set = 0, binding = 1) buffer IndirectCommands {
    uint data[];
} uIndirect;

layout(push_constant) uniform Push {
    uint batchCount;
    uint _pad0;
    uint _pad1;
    uint _pad2;
} uPush;

void main() {
    uint batchIndex = gl_GlobalInvocationID.x;
    if (batchIndex >= uPush.batchCount) {
        return;
    }

    BatchCullHeader header = uBatches.batches[batchIndex];
    const uint stride = 5u;
    const uint base = batchIndex * stride;
    uIndirect.data[base + 1u] = header.visibleCount;
    uIndirect.data[base + 4u] = 0u;
}
