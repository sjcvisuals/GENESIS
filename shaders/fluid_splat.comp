#version 450

layout(local_size_x = 4, local_size_y = 4, local_size_z = 4) in;

layout(set = 0, binding = 0, rgba16f) uniform image3D uVelocity;
layout(set = 0, binding = 2, r16f) uniform image3D uDensity;

layout(push_constant) uniform Push {
    ivec3 gridSize;
    float _pad0;
    vec4 pointRadius;   // xyz = UVW point, w = radius
    vec4 velocityDensity; // xyz = velocity UVW/s, w = density amount
    float addDensity;
    float _pad1;
    float _pad2;
    float _pad3;
} pc;

void main() {
    ivec3 coord = ivec3(gl_GlobalInvocationID.xyz);
    if (any(greaterThanEqual(coord, pc.gridSize))) {
        return;
    }

    vec3 uvw = (vec3(coord) + 0.5) / vec3(pc.gridSize);
    vec3 delta = uvw - pc.pointRadius.xyz;
    float dist2 = dot(delta, delta);
    float radius = max(pc.pointRadius.w, 1e-6);
    float influence = exp(-dist2 / (radius * radius));

    if (influence > 1e-4) {
        vec3 vel = imageLoad(uVelocity, coord).xyz;
        vel += pc.velocityDensity.xyz * influence;
        imageStore(uVelocity, coord, vec4(vel, 0.0));

        if (pc.addDensity > 0.5) {
            float d = imageLoad(uDensity, coord).x;
            d += pc.velocityDensity.w * influence;
            imageStore(uDensity, coord, vec4(d, 0.0, 0.0, 0.0));
        }
    }
}
