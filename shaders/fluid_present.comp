#version 450

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(set = 0, binding = 2, r16f) uniform readonly image2D uDensity;
layout(set = 0, binding = 7, rgba8) uniform writeonly image2D uDisplay;

layout(push_constant) uniform Push {
    ivec2 gridSize;
    vec4 dyeColor;
} pc;

void main() {
    ivec2 coord = ivec2(gl_GlobalInvocationID.xy);
    if (coord.x >= pc.gridSize.x || coord.y >= pc.gridSize.y) {
        return;
    }

    float density = max(imageLoad(uDensity, coord).x, 0.0);
    // Soft blob falloff so dye reads as glowing lava, not a flat tint.
    float glow = clamp(density, 0.0, 4.0);
    vec3 rgb = pc.dyeColor.rgb * (glow + pow(glow, 1.4) * 0.75);
    float alpha = clamp(glow * max(pc.dyeColor.a, 1.0) * 0.85, 0.0, 1.0);

    // Empty cells stay fully transparent so only dye is visible.
    if (alpha < 0.02) {
        rgb = vec3(0.0);
        alpha = 0.0;
    }

    imageStore(uDisplay, coord, vec4(rgb, alpha));
}
