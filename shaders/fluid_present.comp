#version 450

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(set = 0, binding = 2, r16f) uniform readonly image2D uDensity;
layout(set = 0, binding = 7, rgba8) uniform writeonly image2D uDisplay;

layout(push_constant) uniform Push {
    ivec2 gridSize;
    vec4 dyeColor;
} pc;

void main() {
    ivec2 coord = ivec2(gl_GlobalInvocationID.xy);
    if (coord.x >= pc.gridSize.x || coord.y >= pc.gridSize.y) {
        return;
    }

    float density = max(imageLoad(uDensity, coord).x, 0.0);
    // Soft blob falloff so dye reads as glowing lava, not a flat tint.
    float glow = clamp(density, 0.0, 5.0);
    // Emphasize dense cores (wax blobs) vs thin trails.
    float core = smoothstep(0.35, 1.8, glow);
    float rim = smoothstep(0.08, 0.55, glow);
    vec3 warm = pc.dyeColor.rgb;
    vec3 hot = mix(warm, vec3(1.0, 0.85, 0.35), core * 0.55);
    vec3 rgb = hot * (rim * 0.55 + core * 1.35 + pow(glow, 1.35) * 0.35);
    float alpha = clamp((rim * 0.45 + core * 0.85) * max(pc.dyeColor.a, 1.0), 0.0, 1.0);

    // Empty cells stay fully transparent so only dye is visible.
    if (alpha < 0.02) {
        rgb = vec3(0.0);
        alpha = 0.0;
    }

    imageStore(uDisplay, coord, vec4(rgb, alpha));
}
