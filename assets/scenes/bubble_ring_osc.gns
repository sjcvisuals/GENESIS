{
  "format": "gns",
  "version": 1,
  "name": "Arc Energy + OSC Tracker",
  "scene_ref": "bubble_ring_osc.scene.json",
  "pixera": {
    "streams": [
      {
        "handle": "main",
        "resolution_x": 1920,
        "resolution_y": 1080,
        "use_scene_camera": true
      }
    ],
    "bindings": {
      "target_node": "Scene/OSC Tracker",
      "light_node": "Scene/Key Light"
    }
  }
}
