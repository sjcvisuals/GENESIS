{
  "format": "gns",
  "version": 1,
  "name": "Showcase",
  "scene_ref": "showcase.scene.json",
  "pixera": {
    "streams": [
      {
        "handle": "main",
        "resolution_x": 1920,
        "resolution_y": 1080,
        "use_scene_camera": true
      }
    ],
    "bindings": {
      "target_node": "Showcase/Stage/Hero Sphere",
      "light_node": "Showcase/Lighting/Sun"
    }
  }
}
