{
  "format": "gns",
  "version": 1,
  "name": "Default Scene",
  "scene_ref": "default.scene.json",
  "pixera": {
    "streams": [
      {
        "handle": "main",
        "resolution_x": 1920,
        "resolution_y": 1080,
        "use_scene_camera": false
      }
    ],
    "bindings": {
      "target_node": "Scene/Cube",
      "light_node": "Scene/Directional Light"
    }
  }
}
